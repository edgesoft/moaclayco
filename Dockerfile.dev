FROM node:24-bookworm-slim

WORKDIR /app

# The development server uses `ps` to find and stop the previous app-server process before
# starting a new one after a file change. The slim Node image does not include
# it, which leaves the old process on port 3000 and eventually crashes HMR.
RUN apt-get update \
  && apt-get install -y --no-install-recommends procps \
  && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=development
ENV HOST=0.0.0.0
ENV PORT=3000

COPY package.json package-lock.json ./
RUN npm ci --include=dev && node -e "const fs=require('node:fs');const crypto=require('node:crypto');const lock=fs.readFileSync('package-lock.json');fs.writeFileSync('node_modules/.package-lock.sha256',crypto.createHash('sha256').update(lock).digest('hex'))"

COPY . .

EXPOSE 3000 3001

CMD ["sh", "docker/dev-entrypoint.sh", "npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "3000"]
