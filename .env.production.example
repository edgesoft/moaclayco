# Local production-like environment. Copy to .env.production.local and fill in
# values from the Moa Clay Co production environment.

MONGODB_URL=
# Optional when the database name is already present in MONGODB_URL.
MONGODB_DATABASE=

EMAIL_PASSWORD=
EMAIL_USERNAME=
NODE_ENV=development

STRIPE_PUBLIC_KEY=
STRIPE_SRV=
STRIPE_WEBHOOK=

SESSION_SECRET=

# Google OAuth Web application credentials. The callback must exactly match the
# authorized redirect URI configured in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://moaclayco.com/auth/google/callback
GOOGLE_ALLOWED_EMAILS=moaclayco@gmail.com,moagusen@gmail.com,wicket.programmer@gmail.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
AWS_REGION=eu-north-1
AWS_S3_BUCKET_NAME=
AWS_ITEM_PATH=items-prod
AWS_COLLECTION_PATH=collections-prod
AWS_VERIFICATIONS_PATH=verifications-prod

OPENAI_API_KEY=
OPENAI_ACCOUNTING_MODEL=gpt-5.6-terra
