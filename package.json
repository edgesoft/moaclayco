    "deploy": "fly deploy --remote-only",
    "dev": "react-router dev",
    "lint": "eslint app tests",
    "smoke": "node tools/smoke-check.mjs",
    "start": "react-router-serve ./build/server/index.js",
    "test": "tsx --test tests/accounting-balances.test.ts tests/accounting-document.test.ts tests/checkout-payment.test.ts tests/database-connection.test.ts tests/discount-form.test.ts tests/google-auth.test.ts tests/image-processing.test.ts tests/item-image-storage.test.ts tests/loader-data.test.ts tests/openai-responses.test.ts tests/order-cookie.test.ts tests/order-email.test.tsx tests/request-body.test.ts tests/verification-file-content.test.ts tests/verification-files.test.ts tests/verification-schema.test.ts tests/verification-validation.test.ts",
