{
  "name": "moaclayco",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "audit:critical": "npm audit --audit-level=critical",
    "audit:production": "npm audit --omit=dev --audit-level=critical",
    "build": "react-router build",
    "deploy": "fly deploy --remote-only",
    "dev": "react-router dev",
    "lint": "eslint app tests --max-warnings=0",
    "smoke": "node tools/smoke-check.mjs",
    "start": "react-router-serve ./build/server/index.js",
    "test": "tsx --import=./tests/test-environment.mjs --test tests/accounting-balances.test.ts tests/accounting-document.test.ts tests/catalog-cache.test.ts tests/checkout-payment.test.ts tests/collection-order.test.ts tests/collection-removal.test.ts tests/database-connection.test.ts tests/discount-form.test.ts tests/email-delivery.test.ts tests/email-provider.test.ts tests/google-auth.test.ts tests/image-processing.test.ts tests/image-upload.test.ts tests/item-deletion.test.ts tests/item-image-storage.test.ts tests/loader-data.test.ts tests/openai-responses.test.ts tests/order-cookie.test.ts tests/order-email.test.tsx tests/order-image-storage.test.ts tests/request-body.test.ts tests/root-revalidation.test.ts tests/special-order.test.ts tests/storefront-performance.test.ts tests/stripe-webhook.test.ts tests/tax-account-reconciliation.test.ts tests/ui-iconography.test.ts tests/verification-file-content.test.ts tests/verification-files.test.ts tests/verification-schema.test.ts tests/verification-suggestion-dates.test.ts tests/verification-validation.test.ts",
    "test:e2e:accounting": "tsx --test tests/accounting-document.e2e.test.ts",
    "test:e2e:mobile": "playwright test --config=playwright.mobile.config.ts",
    "test:e2e:mobile:list": "playwright test --config=playwright.mobile.config.ts --list",
    "test:e2e:stripe": "node tools/run-stripe-e2e.mjs",
    "test:e2e:stripe:run": "tsx --test tests/stripe-webhook.e2e.test.ts",
    "typecheck": "react-router typegen && tsc"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1109.0",
    "@aws-sdk/lib-storage": "^3.1109.0",
    "@hookform/resolvers": "^5.7.1",
    "@react-router/node": "^8.3.0",
    "@react-router/serve": "^8.3.0",
    "@remix-run/form-data-parser": "^0.17.5",
    "@stripe/react-stripe-js": "^6.8.1",
    "@stripe/stripe-js": "^9.13.0",
    "framer-motion": "^13.1.0",
    "isbot": "^5.2.1",
    "mongoose": "^9.9.2",
    "nodemailer": "^9.0.5",
    "openai": "^7.4.0",
    "openid-client": "^6.8.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "react-router": "^8.3.0",
    "react-select": "^5.10.2",
    "react-toastify": "^11.1.0",
    "react-use-cart": "^1.14.0",
    "sharp": "^0.35.3",
    "stripe": "^22.5.0",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.18.4",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@react-router/dev": "^8.3.0",
    "@react-router/fs-routes": "^8.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.8.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.5",
    "typescript": "^6.0.3",
    "vite": "^8.2.1"
  },
  "overrides": {
    "tar": "7.5.22"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
