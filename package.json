    "openai": "^7.4.0",
    "openid-client": "^6.8.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "react-router": "^8.3.0",
    "react-select": "^5.10.2",
    "react-swipeable": "^7.0.2",
    "react-toastify": "^11.1.0",
    "react-use-cart": "^1.14.0",
    "sharp": "^0.35.3",
    "stripe": "^13.11.0",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
