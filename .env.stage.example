# Full local stage environment. Copy to .env.stage.local and fill values there.

MONGODB_URL=
# Optional when the database name is already present in MONGODB_URL.
MONGODB_DATABASE=

EMAIL_PASSWORD=
EMAIL_USERNAME=
NODE_ENV=development

STRIPE_PUBLIC_KEY=
STRIPE_SRV=
STRIPE_WEBHOOK=

SESSION_SECRET=

# Google OAuth Web application credentials. The callback must exactly match the
# authorized redirect URI configured in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
GOOGLE_ALLOWED_EMAILS=moaclayco@gmail.com,moagusen@gmail.com,wicket.programmer@gmail.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
AWS_REGION=eu-north-1
# The environment bucket; it may be shared between products.
AWS_S3_BUCKET_NAME=moaclayco-stage
AWS_ITEM_PATH=items-stage
AWS_COLLECTION_PATH=collections-stage
AWS_VERIFICATIONS_PATH=verifications-stage

OPENAI_API_KEY=
OPENAI_ACCOUNTING_MODEL=gpt-5.6-terra
